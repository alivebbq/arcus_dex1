[Unit]
Description=Arcus automated grid trading dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcusgrid
Group=arcusgrid
WorkingDirectory=/opt/arcus-grid
EnvironmentFile=/etc/arcus-grid.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/arcus-grid/venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8787 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arcus-grid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
